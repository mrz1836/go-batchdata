{
    "customizations": {
        "vscode": {
            "extensions": [
                "golang.Go",
                "github.vscode-github-actions",
                "eamodio.gitlens"
            ],
            "settings": {
                "editor.codeActionsOnSave": {
                    "source.organizeImports": "explicit"
                },
                "editor.formatOnSave": true,
                "go.lintTool": "golangci-lint",
                "go.toolsEnvVars": {
                    "GOFLAGS": "-buildvcs=false"
                },
                "go.useLanguageServer": true
            }
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "image": "mcr.microsoft.com/devcontainers/go:2-1.26-bookworm",
    "mounts": [
        "type=cache,target=/home/vscode/.cache/go-build",
        "type=bind,source=/var/run/docker.sock,target=/var/run/docker.sock"
    ],
    "name": "go-batchdata dev container",
    "postCreateCommand": "go install github.com/mrz1836/mage-x/cmd/magex@latest && magex lint && magex vet && magex test",
    "postStartCommand": "go install github.com/mrz1836/mage-x/cmd/magex@latest",
    "remoteUser": "vscode",
    "runArgs": [
        "--cap-drop=ALL",
        "--security-opt",
        "no-new-privileges:true"
    ]
}
